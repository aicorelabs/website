<style>
    body.about-page {
        background: #08090B;
        color: #F4F1EA;
    }

    .about-page-wrap {
        --bg: #08090B;
        --ink: #F4F1EA;
        --soft: #CFC8BA;
        --muted: #8F897F;
        --line: rgba(244, 241, 234, 0.12);
        --panel: rgba(244, 241, 234, 0.045);
        --blue: #0145F2;
        --amber: #D7A85E;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Archivo', 'Inter', sans-serif;
        overflow: hidden;
    }

    .about-page-wrap * {
        text-wrap: pretty;
    }

    .about-shell {
        width: min(100% - 32px, 1320px);
        margin: 0 auto;
    }

    .about-hero {
        min-height: 88dvh;
        padding: clamp(8rem, 14vw, 12rem) 0 clamp(4rem, 8vw, 6rem);
        border-bottom: 1px solid var(--line);
        background:
