            url('/assets/home-method-consulting.webp');
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .about-hero::after {
        content: "";
        position: absolute;
        inset: auto 0 0;
        height: 32%;
        background: linear-gradient(180deg, transparent, #08090B);
        pointer-events: none;
    }

    .about-hero-grid,
    .about-split {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 24px;
        position: relative;
        z-index: 1;
    }

    .about-hero-copy {
        grid-column: span 8;
        max-width: 68rem;
    }

    .about-hero-note {
        grid-column: 9 / span 4;
        align-self: end;
        border-left: 1px solid var(--line);
        padding-left: clamp(1.5rem, 3vw, 2.5rem);
        color: var(--soft);
        line-height: 1.65;
    }

    .about-title {
        color: var(--ink);
        font-size: clamp(3.4rem, 6.8vw, 7rem);
        line-height: 0.95;
        letter-spacing: 0;
        font-weight: 700;
        text-wrap: balance;
    }

    .about-subhead {
        max-width: 45rem;
        margin-top: 2rem;
        color: var(--soft);
        font-size: clamp(1.12rem, 1.8vw, 1.42rem);
        line-height: 1.58;
    }

    .about-section {
        padding: clamp(5rem, 10vw, 8.5rem) 0;
        border-bottom: 1px solid var(--line);
    }

    .about-section-title {
        color: var(--ink);
        font-size: clamp(2.6rem, 4.8vw, 4.9rem);
        line-height: 1;
        letter-spacing: 0;
        font-weight: 700;
        text-wrap: balance;
    }

    .about-copy {
        color: var(--muted);
        line-height: 1.7;
        max-width: 43rem;
    }

    .about-copy strong {
        color: var(--ink);
        font-weight: 600;
    }

    .about-intro {
        grid-column: span 5;
    }

    .about-body {
        grid-column: 7 / span 6;
        display: grid;
        gap: 1.2rem;
    }

    .about-principles {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        border: 1px solid var(--line);
        background: var(--line);
    }

    .about-principle {
        min-height: 18rem;
        padding: clamp(1.4rem, 3vw, 2.3rem);
        background: rgba(244, 241, 234, 0.035);
    }

    .about-principle h3 {
        color: var(--ink);
        font-size: 1.35rem;
        line-height: 1.15;
        font-weight: 700;
    }

    .about-principle p {
        margin-top: 1rem;
        color: var(--muted);
        line-height: 1.62;
    }

    .about-proof {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
    }

    .about-proof-list {
        display: grid;
        border-top: 1px solid var(--line);
    }

    .about-proof-row {
        display: grid;
        grid-template-columns: 5rem 1fr;
        gap: 1.4rem;
        padding: 1.35rem 0;
        border-bottom: 1px solid var(--line);
        align-items: start;
    }

    .about-proof-row span {
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
    }

    .about-proof-row strong {
        color: var(--ink);
        font-size: 1.18rem;
        line-height: 1.3;
        font-weight: 600;
    }

    .about-cta {
        padding: clamp(4rem, 9vw, 7rem) 0;
    }

    .about-cta-box {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: clamp(2rem, 6vw, 5rem);
        align-items: end;
        padding: clamp(2rem, 5vw, 4.5rem);
        border: 1px solid var(--line);
        background:
            linear-gradient(90deg, rgba(8, 9, 11, 0.94), rgba(8, 9, 11, 0.78)),
            url('/assets/home-footer-consulting.webp');
        background-size: cover;
        background-position: center;
    }

    .about-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .about-page-wrap .btn {
        border-radius: 6px;
    }

    @media (max-width: 980px) {
        .about-hero-grid,
        .about-split,
        .about-proof,
        .about-cta-box {
            grid-template-columns: 1fr;
        }

        .about-hero-copy,
        .about-hero-note,
        .about-intro,
        .about-body {
            grid-column: auto;
        }

        .about-hero-note {
            border-left: 0;
            border-top: 1px solid var(--line);
            padding-left: 0;
            padding-top: 1.5rem;
        }

        .about-principles {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .about-shell {
            width: min(100% - 48px, 1320px);
        }

        .about-hero {
            min-height: auto;
            padding-top: 7rem;
        }

        .about-principles {
            grid-template-columns: 1fr;
        }

        .about-principle {
            min-height: 12rem;
        }

        .about-proof-row {
            grid-template-columns: 3rem 1fr;
            gap: 1rem;
        }
    }
</style>

