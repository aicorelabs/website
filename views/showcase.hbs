<style>
    body.showcase-page {
        background: #08090B;
        color: #F4F1EA;
    }

    .showcase {
        --bg: #08090B;
        --ink: #F4F1EA;
        --soft: #CFC8BA;
        --muted: #8F897F;
        --line: rgba(244, 241, 234, 0.12);
        --panel: rgba(244, 241, 234, 0.045);
        --panel-strong: rgba(244, 241, 234, 0.075);
        --blue: #0145F2;
        --amber: #D7A85E;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Archivo', 'Inter', sans-serif;
        overflow: hidden;
    }

    .showcase * {
        text-wrap: pretty;
    }

    .showcase-shell {
        width: min(100% - 32px, 1320px);
        margin: 0 auto;
    }

    .showcase-hero {
        padding: clamp(8rem, 14vw, 12rem) 0 clamp(4rem, 7vw, 6rem);
        border-bottom: 1px solid var(--line);
        background:
            linear-gradient(180deg, rgba(8, 9, 11, 0.92), #08090B 70%),
            radial-gradient(circle at 78% 16%, rgba(1, 69, 242, 0.2), transparent 28rem);
    }

    .showcase-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
        gap: clamp(2rem, 7vw, 7rem);
        align-items: end;
    }

    .showcase-title {
        max-width: 58rem;
        color: var(--ink);
        font-size: clamp(3.4rem, 6.5vw, 6.6rem);
        line-height: 0.96;
        letter-spacing: 0;
        font-weight: 700;
        text-wrap: balance;
    }

    .showcase-subhead {
        max-width: 40rem;
        color: var(--soft);
        font-size: clamp(1.1rem, 1.7vw, 1.35rem);
        line-height: 1.58;
    }

    .showcase-proof {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin-top: clamp(3rem, 7vw, 5rem);
        border: 1px solid var(--line);
        background: var(--line);
    }

    .showcase-proof div {
        min-height: 8rem;
        padding: 1.25rem;
        background: rgba(244, 241, 234, 0.035);
        display: flex;
        align-items: end;
    }

    .showcase-proof strong {
        color: var(--ink);
        font-size: clamp(1.1rem, 1.6vw, 1.35rem);
        line-height: 1.15;
        font-weight: 600;
    }

    .showcase-section {
        padding: clamp(4.5rem, 9vw, 8rem) 0;
        border-bottom: 1px solid var(--line);
    }

    .showcase-section-head {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: clamp(2rem, 6vw, 6rem);
        align-items: end;
        margin-bottom: 3rem;
    }

    .showcase-section-title {
        color: var(--ink);
        font-size: clamp(2.55rem, 4.6vw, 4.75rem);
        line-height: 1;
        letter-spacing: 0;
        font-weight: 700;
        text-wrap: balance;
    }

    .showcase-copy {
        max-width: 42rem;
        color: var(--muted);
        line-height: 1.66;
    }

    .work-list {
        display: grid;
        border-top: 1px solid var(--line);
    }

    .work-item {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
        gap: clamp(1.75rem, 5vw, 5rem);
        padding: clamp(2rem, 5vw, 4rem) 0;
        border-bottom: 1px solid var(--line);
        align-items: center;
    }

    .work-item:nth-child(even) .work-media {
        order: -1;
    }

    .work-content {
        display: grid;
        gap: 1.3rem;
    }

    .work-content h3 {
        color: var(--ink);
        font-size: clamp(2rem, 3.4vw, 3.45rem);
        line-height: 1.02;
        letter-spacing: 0;
        font-weight: 700;
    }

    .work-content p {
        color: var(--soft);
        font-size: 1.05rem;
        line-height: 1.62;
        max-width: 42rem;
    }

    .work-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.2rem;
    }

    .work-meta span {
        border: 1px solid rgba(244, 241, 234, 0.14);
        color: var(--soft);
        padding: 0.48rem 0.62rem;
        font-size: 0.82rem;
        line-height: 1;
    }

    .work-outcome {
        display: grid;
        gap: 0.8rem;
        margin-top: 0.35rem;
        color: var(--muted);
        line-height: 1.55;
    }

    .work-outcome li {
        list-style: none;
        position: relative;
        padding-left: 1.1rem;
    }

    .work-outcome li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.72em;
        width: 0.34rem;
        height: 0.34rem;
        border-radius: 999px;
        background: var(--amber);
    }

    .work-media {
        position: relative;
        border: 1px solid var(--line);
        background: var(--panel);
        overflow: hidden;
    }

    .work-media img {
        display: block;
        width: 100%;
        height: auto;
        filter: saturate(0.92) contrast(1.04);
        transition: transform 500ms ease, filter 500ms ease;
    }

    .work-item:hover .work-media img {
        transform: scale(1.025);
        filter: saturate(1) contrast(1.06);
    }

    .showcase-cta {
        padding: clamp(4rem, 9vw, 7rem) 0;
    }

    .showcase-cta-box {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: clamp(2rem, 6vw, 5rem);
        align-items: end;
        padding: clamp(2rem, 5vw, 4.5rem);
        border: 1px solid var(--line);
        background:
            linear-gradient(90deg, rgba(8, 9, 11, 0.92), rgba(8, 9, 11, 0.76)),
            url('/assets/home-footer-consulting.webp');
        background-size: cover;
        background-position: center;
    }

    .showcase .btn {
        border-radius: 6px;
    }

    .showcase-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    @media (max-width: 980px) {
        .showcase-hero-grid,
        .showcase-section-head,
        .work-item,
        .showcase-cta-box {
            grid-template-columns: 1fr;
        }

        .work-item:nth-child(even) .work-media {
            order: 0;
        }

        .showcase-proof {
            grid-template-columns: 1fr;
        }
    }
</style>

